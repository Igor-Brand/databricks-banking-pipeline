{
  "datasets": [
    {
      "name": "4247682d",
      "displayName": "Total Customers",
      "queryLines": [
        "SELECT COUNT(DISTINCT customer_id) AS total_customers\r\n",
        "FROM banking.gold.customer_360;"
      ]
    },
    {
      "name": "1079f0b2",
      "displayName": "Total Deposits",
      "queryLines": [
        "SELECT SUM(total_balance) AS total_deposits FROM banking.gold.customer_360"
      ]
    },
    {
      "name": "5ad7da73",
      "displayName": "Total Transactions",
      "queryLines": [
        "SELECT SUM(total_transactions) AS total_transactions from banking.gold.customer_360"
      ]
    },
    {
      "name": "c372f54f",
      "displayName": "High Risk Customers",
      "queryLines": [
        "SELECT COUNT(*) AS high_risk_customers FROM banking.gold.customer_360 WHERE risk_grade = 'HIGH'"
      ]
    },
    {
      "name": "b0a3172a",
      "displayName": "Customer Segment Distribuition",
      "queryLines": [
        "SELECT customer_segment, COUNT(*) AS customers FROM banking.gold.customer_360 GROUP BY customer_segment"
      ]
    },
    {
      "name": "9f59b8cc",
      "displayName": "Credit Risk Distribuition",
      "queryLines": [
        "SELECT risk_grade, COUNT(*) AS customers FROM banking.gold.customer_360 GROUP BY risk_grade"
      ]
    },
    {
      "name": "80778966",
      "displayName": "Top Customers",
      "queryLines": [
        "SELECT DISTINCT\r\n",
        "    customer_name,\r\n",
        "    branch_name,\r\n",
        "    total_balance\r\n",
        "FROM banking.gold.customer_360\r\n",
        "ORDER BY total_balance DESC\r\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "4c151298",
      "displayName": "Branch Deposits",
      "queryLines": [
        "SELECT branch_name, total_deposits FROM banking.gold.branch_performance ORDER BY total_deposits DESC "
      ]
    },
    {
      "name": "46505b58",
      "displayName": "Branch Customers",
      "queryLines": [
        "SELECT branch_name, total_customers FROM banking.gold.branch_performance ORDER BY total_customers DESC"
      ]
    },
    {
      "name": "d2d2c7b3",
      "displayName": "Branch Transactions",
      "queryLines": [
        "SELECT branch_name, total_transaction_amount FROM banking.gold.branch_performance ORDER BY total_transaction_amount"
      ]
    },
    {
      "name": "0fe4f139",
      "displayName": "Gateway Transactions",
      "queryLines": [
        "SELECT \r\n",
        "  gateway_name, \r\n",
        "  SUM(successful_transactions) AS successful_transactions, \r\n",
        "  SUM(failed_transactions) AS failed_transactions \r\n",
        "FROM banking.gold.transaction_channel_summary\r\n",
        "GROUP BY gateway_name"
      ]
    },
    {
      "name": "9fe48ded",
      "displayName": "Device Transactions",
      "queryLines": [
        "SELECT device_type, SUM(total_transactions) AS total_transactions \r\n",
        "FROM banking.gold.transaction_channel_summary \r\n",
        "GROUP BY device_type"
      ]
    },
    {
      "name": "gateway_unpivot",
      "displayName": "Gateway Transactions Unpivoted",
      "queryLines": [
        "SELECT\n",
        "  gateway_name,\n",
        "  'Successful' AS transaction_type,\n",
        "  SUM(successful_transactions) AS transaction_count\n",
        "FROM\n",
        "  banking.gold.transaction_channel_summary\n",
        "GROUP BY\n",
        "  gateway_name\n",
        "UNION ALL\n",
        "SELECT\n",
        "  gateway_name,\n",
        "  'Failed' AS transaction_type,\n",
        "  SUM(failed_transactions) AS transaction_count\n",
        "FROM\n",
        "  banking.gold.transaction_channel_summary\n",
        "GROUP BY\n",
        "  gateway_name"
      ]
    }
  ],
